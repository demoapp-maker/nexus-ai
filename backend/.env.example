# Runtime
NEXUS_ENV=development
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000
NEXUS_LOG_LEVEL=INFO
# Development-only deterministic provider for local smoke tests.
NEXUS_MOCK_AI=false

# Local SQLite is used when DATABASE_URL is empty. Use PostgreSQL in production.
DATABASE_URL=
NEXUS_MEMORY_DB=./data/nexus_memory.db

# CORS: comma-separated browser origins. Same-origin deployments can leave this blank.
CORS_ORIGINS=http://localhost:5008,http://localhost:3000

# Abuse protection
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=2097152

# Memory policy: keep cross-user/global memory disabled by default.
ENABLE_GLOBAL_MEMORY=false

# AI providers
DEFAULT_AI_PROVIDER=openrouter
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REFERER=http://localhost:5008
OPENROUTER_TITLE=Nexus AI
ALLOW_PAID_MODELS=false

DUCKAI_URL=http://localhost:3000/v1/chat/completions
DUCKAI_API_KEY=
DUCKAI_MODEL=gpt-4o-mini

ALIBABA_AI_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
ALIBABA_AI_KEY=
ALIBABA_AI_MODEL=qwen-plus

# Required to enable admin endpoints. Never leave this empty in production.
ADMIN_PANEL_TOKEN=
# Fernet key for API keys stored through /admin/config.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_CONFIG_ENCRYPTION_KEY=
